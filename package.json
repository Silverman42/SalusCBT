{
  "name": "salus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:convex": "convex dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && tsc -p convex --noEmit && tsc -p scripts --noEmit && tsc -p tests --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:json": "tsx scripts/parse-exam.ts content/source/secplus-701-mock-exam.md > content/seed/sy0-701.json && prettier --write content/seed/sy0-701.json",
    "seed:import": "tsx scripts/seed-import.ts",
    "seed": "npm run seed:json && npm run seed:import --"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.13.0",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@nuxt/ui": "^4.12.0",
    "better-auth": "1.7.18",
    "convex": "^1.49.0",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@iconify-json/lucide": "^1.2.152",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "convex-test": "^0.0.67",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
