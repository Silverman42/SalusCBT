# Never commit real values (SE-8). Full list in docs/LLD.md §15.2.
#
# Local development: `npx convex dev` writes CONVEX_DEPLOYMENT, CONVEX_URL and
# CONVEX_SITE_URL to .env.local on first run, and nuxt.config.ts reads
# CONVEX_URL and CONVEX_SITE_URL from there.
#
# Netlify: the build sets NUXT_PUBLIC_CONVEX_URL via `convex deploy`.
NUXT_PUBLIC_CONVEX_URL=

# Target of the /api/auth proxy: https://<deployment>.convex.site (server only).
NUXT_CONVEX_SITE_URL=

# Shared secret, same value as SERVER_SECRET on the Convex deployment
# (`npx convex env set SERVER_SECRET ...`). Lets Convex trust the client IP the
# auth proxy forwards. Generate with `openssl rand -base64 32`.
NUXT_SERVER_SECRET=

# HMAC key for the client-IP hash /api/attempts/start sends to Convex for its
# per-IP rate limit (LLD §7.1). Server only; Convex never sees it or the raw
# IP. Changing it resets the per-IP buckets. Generate with
# `openssl rand -base64 32`.
NUXT_IP_PEPPER=
